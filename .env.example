# Use the "Any Client" / TCP connection string from Prisma Console (postgres://...), not prisma+postgres://
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Create a random 32-character string or run `npx auth secret`
AUTH_SECRET="RANDOM_32_CHARACTER_STRING"

# Required in production (Vercel). Locally optional.
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob — required for post file attachments (local + production)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
